# Copy to config.env, fill in, then chmod 600 config.env.
# config.env holds credentials and must never be committed.

# MAC of the lamp the service connects to (Telink OUI A4:C1:38:...).
# Find it with:  bluetoothctl --timeout 20 scan on  &&  bluetoothctl devices
AWOX_MAC=AA:BB:CC:DD:EE:FF

# Mesh credentials. Obtain them with the tool from fsaris (sign in with your
# AwoX/EGLO Connect account):
# https://fsaris.github.io/EspHome-AwoX-BLE-mesh-hub/awoxh-mesh-credentials-tool/
# The mesh_name matching the BLE name in your scan is the right one.
AWOX_MESH_NAME=
AWOX_MESH_PASSWORD=

# Real mesh address of the lamp -- it appears in the first two bytes of every
# status block. There is no safe default; leave it empty to be asked.
AWOX_MESH_ID=

# Optional access protection. When set, every request must send the header
# "X-API-Key: <value>". Empty = unprotected (LAN only).
AWOX_API_KEY=

AWOX_HOST=0.0.0.0
AWOX_PORT=8087
AWOX_LOG_LEVEL=INFO

# BLE backend: auto (gatt when gatttool is installed, else bleak), gatt or bleak.
# "gatt" is required for /state and schedule reads -- the status characteristic
# has no CCCD, so notifications only arrive through gatttool.
AWOX_BACKEND=auto

# Seconds to wait for an advertisement. AwoX lamps advertise very rarely, so
# scanning long is usually better.
AWOX_ADV_TIMEOUT=600

# Subscribe to status notifications (bleak backend only). Off by default:
# BlueZ' StartNotify() fails with "Unlikely Error" and the chip drops the link.
AWOX_NOTIFICATIONS=0

# Optional: force a specific Bluetooth adapter (e.g. hci1) and/or a command that
# re-enumerates the adapter after repeated connect failures.
#AWOX_ADAPTER=hci0
#AWOX_ADAPTER_RECALL_CMD=/usr/local/sbin/bt-dongle-recall