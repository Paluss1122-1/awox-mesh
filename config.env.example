# Copy to config.env, fill in, then chmod 600 config.env.
# config.env holds credentials and must never be committed.
#
# The CLI and the bridge load ./config.env automatically, so you do NOT have to
# export these variables. Real environment variables still take precedence.

# MAC of the lamp the service connects to (Telink OUI A4:C1:38:...).
# These lamps advertise only every ~25 s, so scan for a while. Easiest:
#   awox scan --timeout 120        # lists AwoX lamps with name + MAC
# Several lamps can share the same BLE name -- pick by MAC.
AWOX_MAC=AA:BB:CC:DD:EE:FF

# Mesh credentials. Read them with the tool from fsaris:
# https://fsaris.github.io/EspHome-AwoX-BLE-mesh-hub/awoxh-mesh-credentials-tool/
#   1. Use the "Using AwoX HomeControl" login form, NOT "AwoX Smart CONTROL".
#   2. The tool returns one set per service. Take the set whose mesh_name equals
#      the BLE name of your lamp in a scan.
#   3. Ignore its "look for service: mesh" hint -- it is misleading. On the
#      tested lamp the correct set carried service "zigbee".
AWOX_MESH_NAME=
AWOX_MESH_PASSWORD=

# Real mesh address of the lamp. Cannot be derived from MAC or name and has no
# safe default. Leave it EMPTY, run `awox discover`, then paste the id here.
AWOX_MESH_ID=

# Optional access protection. When set, every request must send the header
# "X-API-Key: <value>". Empty = unprotected (LAN only).
AWOX_API_KEY=

# Bind address of the bridge. 127.0.0.1 = only this machine (safe default).
# Set 0.0.0.0 only if another device (e.g. Home Assistant on a different host)
# must reach it -- and then also set AWOX_API_KEY below.
AWOX_HOST=127.0.0.1
AWOX_PORT=8087
AWOX_LOG_LEVEL=INFO

# BLE backend: auto (gatt when gatttool is installed, else bleak), gatt or bleak.
# "gatt" is required for /state and schedule reads -- the status characteristic
# has no CCCD, so notifications only arrive through gatttool.
AWOX_BACKEND=auto

# Seconds to wait for an advertisement. AwoX lamps advertise very rarely, so
# scanning long is usually better.
AWOX_ADV_TIMEOUT=600

# Subscribe to status notifications (bleak backend only). Off by default:
# BlueZ' StartNotify() fails with "Unlikely Error" and the chip drops the link.
AWOX_NOTIFICATIONS=0

# Optional: force a specific Bluetooth adapter (e.g. hci1) and/or a command that
# re-enumerates the adapter after repeated connect failures.
#AWOX_ADAPTER=hci0
#AWOX_ADAPTER_RECALL_CMD=/usr/local/sbin/bt-dongle-recall